{
  "name": "cgendio-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:poster": "remotion still src/remotion/index.ts HeroFilm public/hero-poster.png --frame=904",
    "remotion:render": "remotion render src/remotion/index.ts HeroFilm docs/design/hero-film.mp4 && remotion render src/remotion/index.ts HeroFilmMobile docs/design/hero-film-mobile.mp4"
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@remotion/cli": "4.0.537",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
