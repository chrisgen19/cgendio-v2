{
  "name": "cgendio-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:poster": "remotion still src/remotion/index.ts HeroFilm public/hero-poster.png --frame=904",
    "remotion:render": "remotion render src/remotion/index.ts HeroFilm docs/design/hero-film.mp4 && remotion render src/remotion/index.ts HeroFilmMobile docs/design/hero-film-mobile.mp4",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.537",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@remotion/cli": "4.0.537",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "7.10.1",
    "shadcn": "4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  }
}
