# Postgres. Local development uses the Docker database from compose.yaml (`pnpm db:up`).
# Production runs Postgres in Coolify on the Hostinger VPS: use the internal connection URL Coolify shows for the
# database service (its Docker network hostname, no public port), e.g.
#   postgresql://USER:PASSWORD@<coolify-service-hostname>:5432/cgendio
# `next build` reads the database too (the home page is prerendered from it), so the build needs this URL as well.
DATABASE_URL="postgresql://cgendio:cgendio@localhost:5437/cgendio"

# Better Auth (admin sign-in). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app. Local callback: http://localhost:3000/api/auth/callback/github (production gets its own app in Phase 9)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Only these emails can sign in to /admin (comma-separated; your GitHub primary email)
ADMIN_EMAILS=""

# Cloudflare R2 (uploads: cover images and the CV). Token: Object Read & Write, scoped to the bucket
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="cgendio-media"
# Public base URL of the bucket (r2.dev URL or a custom domain), no trailing slash
R2_PUBLIC_URL=""

# Contact form email (Resend). Optional: without a key, messages are still stored in the admin inbox and the email is
# skipped (printed to the server log in development). The notification goes to the contact email in admin Settings.
RESEND_API_KEY=""
# Sender; must be a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account address.
MAIL_FROM="Cgdiomampo.dev <onboarding@resend.dev>"
