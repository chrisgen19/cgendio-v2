// Content for cgdiomampo.dev. Mirrors the Phase 3 shapes in src/server/content-schema.ts; src/server/content.ts
// maps these rows to them, so components never see Prisma types. Tables and columns are snake_case.
// Better Auth's tables are at the end.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // .ts import paths let Node 24 run the seed (prisma/seed.ts) without a TypeScript loader
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED

  @@map("content_status")
}

enum ProjectGroup {
  CLIENT
  PERSONAL

  @@map("project_group")
}

enum ProjectTheme {
  INK
  LIME
  TINT
  GRAY

  @@map("project_theme")
}

enum TimelineDot {
  LIME
  ACCENT
  INK
  PLACEHOLDER

  @@map("timeline_dot")
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  summary       String
  kindLabel     String        @map("kind_label")
  group         ProjectGroup
  glyph         String
  theme         ProjectTheme
  /// Columns out of 12 in the Work grid: 4, 5, 6 or 7
  span          Int
  tags          String[]
  featured      Boolean       @default(false)
  order         Int
  status        ContentStatus @default(DRAFT)
  coverImageUrl String?       @map("cover_image_url")
  /// Markdown
  caseStudy     String?       @map("case_study")
  liveUrl       String?       @map("live_url")
  repoUrl       String?       @map("repo_url")
  /// Case study facts row; the page shows [Client] / [Role] placeholders while these are empty
  client        String?
  role          String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status, featured, order])
  @@map("projects")
}

model Post {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String
  tag           String
  /// Markdown
  body          String
  /// Computed from the body when it's saved (Phase 5)
  readMinutes   Int           @map("read_minutes")
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  coverImageUrl String?       @map("cover_image_url")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("posts")
}

model Milestone {
  id          String   @id @default(cuid())
  /// Stable handle so the seed can skip rows that already exist
  key         String   @unique
  kind        String
  value       String
  title       String
  description String
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("milestones")
}

model TimelineEntry {
  id          String      @id @default(cuid())
  /// Stable handle so the seed can skip rows that already exist
  key         String      @unique
  when        String
  role        String
  org         String
  description String
  dot         TimelineDot
  isCurrent   Boolean     @default(false) @map("is_current")
  order       Int
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("timeline_entries")
}

model StackItem {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stack_items")
}

/// A single row (id "site")
model SiteSettings {
  id             String   @id @default("site")
  contactEmail   String   @map("contact_email")
  openToProjects Boolean  @default(true) @map("open_to_projects")
  cvUrl          String?  @map("cv_url")
  /// {github, linkedin, ...}: profile URLs, null until known
  socials        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// Better Auth 1.7 tables (generated with `pnpm dlx auth@1.7.12 generate`, then mapped to snake_case; the adapter
// only sees the Prisma model and field names). Only emails in ADMIN_EMAILS ever get a user row.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// Editable home page copy: eyebrows, headings, ledes, the About statement and facts, CTA labels. Keys are fixed in
/// src/server/content-schema.ts (PAGE_COPY_KEYS); `[[...]]` marks the highlighted words in a heading.
model PageCopy {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("page_copy")
}
